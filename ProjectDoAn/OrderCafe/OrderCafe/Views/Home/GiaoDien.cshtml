<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Hạt Coffee</title>
</head>
<body>
    <<header class="top">
        <div class="wrap bar">
            <a class="logo" href="#/">HẠT<small>COFFEE</small></a>
            <button class="burger" id="burger" aria-label="Mở menu">☰</button>
            <nav id="nav">
                <a href="#/" data-nav="home">Trang chủ</a>
                <a href="#/menu" data-nav="menu">Menu</a>
                <a href="#/uudai" data-nav="uudai">Ưu đãi</a>
                <a href="#/thongtin" data-nav="thongtin">Thông tin</a>
                <a class="hot" href="tel:123456789">📞 123456789</a>
            </nav>
        </div>
    </header>

    @*Giao Dien Trang Chu*@
    <div class="view" id="view-home">
        @*Hinh anh quan *@
        <section class="slider" id="trangchu">
            <div class="overlay">
                <div class="wrap">
                    <span class="eyebrow">Hạt Coffee · Since 2019</span>
                    <h1>Suy nghĩ slogan đi ae</h1>
                    <div class="cta">
                        <a class="btn gold" href="#/menu">Xem menu</a>
                        <a class="btn line" href="#gioithieu">Về quán</a>
                    </div>
                </div>
            </div>
            <div class="dots" id="dots"></div>
        </section>
    </div>
    @*Gioi thieu,h hoat dong,hotline *@
    <section id="gioithieu" class="sec">
        <div class="wrap info">
            <div class="reveal">
                <span class="eyebrow">Chúng tôi là</span>
                <h2>Hạt Coffee</h2>
                <p class="lead">“Chúng tôi đi khắp Tây Nguyên để tìm những hạt cà phê ngon nhất, rồi mang về rang mỗi sáng cho bạn.”</p>
                <p>Hạt Coffee là quán cà phê rang xay nằm giữa Quận 10, Sài Gòn. Ở đây bạn có thể làm việc, học bài, hẹn bạn bè hoặc chỉ ngồi yên với một tách cà phê thơm trong không gian nhiều cây xanh và nắng.</p>
            </div>
            <div class="card reveal">
                <h3>Giờ hoạt động</h3>
                <ul class="hours">
                    <li><span>Thứ 2 - Thứ 6</span><b>07:00 - 22:00</b></li>
                    <li><span>Thứ 7-Chủ Nhật</span><b>07:00 - 23:00</b></li>
                </ul>
                <div class="hotline">Hotline<a href="tel:123456789">123456789</a></div>
                <p class="addr"> 828 Sư Vạn Hạnh, Quận 10, TP. Hồ Chí Minh</p>
            </div>
        </div>
    </section>
</body>
</html>
