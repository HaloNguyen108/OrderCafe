@model IEnumerable<OrderCafe.Models.OrderDetail>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_MasterAdmin.cshtml";
}

<h2>Index</h2>

<p>
    @* Tạo liên kết điều hướng đến action được chỉ định trong ứng dụng MVC. *@
    @Html.ActionLink("Create New", "Create")
</p>
@* Bắt đầu bảng dùng để trình bày danh sách dữ liệu theo hàng và cột. *@
<table class="table">
    <tr>
        <th>
            @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
            @Html.DisplayNameFor(model => model.ProductName)
        </th>
        <th>
            @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
            @Html.DisplayNameFor(model => model.UnitPrice)
        </th>
        <th>
            @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
            @Html.DisplayNameFor(model => model.Quantity)
        </th>
        <th>
            @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
            @Html.DisplayNameFor(model => model.OrderPro.ReceiverName)
        </th>
        <th>
            @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
            @Html.DisplayNameFor(model => model.Product.ProductName)
        </th>
        <th></th>
    </tr>

@* Lặp qua các phần tử của model để dựng giao diện cho từng bản ghi. *@
@foreach (var item in Model) {
    <tr>
        <td>
            @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
            @Html.DisplayFor(modelItem => item.ProductName)
        </td>
        <td>
            @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
            @Html.DisplayFor(modelItem => item.UnitPrice)
        </td>
        <td>
            @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
            @Html.DisplayFor(modelItem => item.Quantity)
        </td>
        <td>
            @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
            @Html.DisplayFor(modelItem => item.OrderPro.ReceiverName)
        </td>
        <td>
            @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
            @Html.DisplayFor(modelItem => item.Product.ProductName)
        </td>
        <td>
            @* Tạo liên kết điều hướng đến action được chỉ định trong ứng dụng MVC. *@
            @Html.ActionLink("Edit", "Edit", new { id=item.OrderDetailId }) |
            @* Tạo liên kết điều hướng đến action được chỉ định trong ứng dụng MVC. *@
            @Html.ActionLink("Details", "Details", new { id=item.OrderDetailId }) |
            @* Tạo liên kết điều hướng đến action được chỉ định trong ứng dụng MVC. *@
            @Html.ActionLink("Delete", "Delete", new { id=item.OrderDetailId })
        </td>
    </tr>
}

</table>
