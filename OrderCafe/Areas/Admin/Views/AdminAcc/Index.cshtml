@model IEnumerable<OrderCafe.Models.AdminUser>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_MasterAdmin.cshtml";
}


<div class="account-page-heading">
    <div>
        <p class="account-eyebrow">QUẢN TRỊ · TÀI KHOẢN</p>
        <h1>Danh sách tài khoản admin</h1>
        <p class="account-description">Quản lý quyền truy cập của nhân viên cửa hàng.</p>
    </div> 

    @* Tạo liên kết điều hướng đến action được chỉ định trong ứng dụng MVC. *@
    @Html.ActionLink("Create New", "Create", null, new { @class = "account-add-button" })
</div>
<div class="table-scroll">
    @* Bắt đầu bảng dùng để trình bày danh sách dữ liệu theo hàng và cột. *@
    <table class="table admin-table account-table ">
        <tr>
            <th>
                @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
                @Html.DisplayNameFor(model => model.Username)
            </th>
            <th>
                @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
                @Html.DisplayNameFor(model => model.FullName)
            </th>
            <th>
                @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
                @Html.DisplayNameFor(model => model.Role)
            </th>
            <th>
                @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th>
                @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th></th>
        </tr>

        @* Lặp qua các phần tử của model để dựng giao diện cho từng bản ghi. *@
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
                    @Html.DisplayFor(modelItem => item.Username)
                </td>
                <td>
                    @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
                    @Html.DisplayFor(modelItem => item.FullName)
                </td>
                <td>
                    @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
                    @Html.DisplayFor(modelItem => item.Phone)
                </td>
                <td>
                    @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
                    @Html.DisplayFor(modelItem => item.Role)
                </td>
                <td>
                    <span class="account-status @(item.IsActive ? "status-active" : "status-locked")">
                        @(item.IsActive ? "Đang hoạt động" : "Đã khóa")
                    </span>
                </td>
                <td>
                    @* Hiển thị giá trị hoặc tên thuộc tính của model theo chế độ chỉ đọc. *@
                    @Html.DisplayFor(modelItem => item.CreatedAt)
                </td>
                <td>
                    @(string.IsNullOrWhiteSpace(item.Email) ? "—" : item.Email)
                </td>
                <td>
                    <!-- Nhóm các nút thao tác để chúng nằm cạnh nhau -->
                    <div class="action-buttons">
                        @* Tạo liên kết điều hướng đến action được chỉ định trong ứng dụng MVC. *@
                        @Html.ActionLink("Edit", "Edit", new { id = item.AdminId }, new { @class = "account-action action-edit" })
                        @* Tạo liên kết điều hướng đến action được chỉ định trong ứng dụng MVC. *@
                        @Html.ActionLink("Details", "Details", new { id = item.AdminId }, new { @class = "account-action action-details" })
                        @* Tạo liên kết điều hướng đến action được chỉ định trong ứng dụng MVC. *@
                        @Html.ActionLink("Delete", "Delete", new { id = item.AdminId }, new { @class = "account-action action-delete" })
                    </div>
                </td>
            </tr>
        }

    </table>
</div>
