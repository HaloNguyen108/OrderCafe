@model OrderCafe.Models.Category

@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_MasterAdmin.cshtml";
}

<h2>Create</h2>

@* Gửi dữ liệu biểu mẫu đến action được chỉ định; action này xử lý thao tác tạo hoặc cập nhật. *@
@using (Html.BeginForm()) 
{
    @* Sinh mã chống giả mạo yêu cầu để máy chủ xác nhận form được gửi từ website. *@
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        <h4>Category</h4>
        <hr />
        @* Hiển thị các lỗi kiểm tra chung của model sau khi form được gửi. *@
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @* Tạo nhãn gắn với thuộc tính model để người dùng biết nội dung cần nhập hoặc xem. *@
            @Html.LabelFor(model => model.CategoryName, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @* Tạo điều khiển form liên kết với thuộc tính model để gửi giá trị về controller. *@
                @Html.EditorFor(model => model.CategoryName, new { htmlAttributes = new { @class = "form-control" } })
                @* Hiển thị lỗi kiểm tra ngay cạnh trường dữ liệu tương ứng. *@
                @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @* Tạo nhãn gắn với thuộc tính model để người dùng biết nội dung cần nhập hoặc xem. *@
            @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div class="checkbox">
                    @* Tạo điều khiển form liên kết với thuộc tính model để gửi giá trị về controller. *@
                    @Html.EditorFor(model => model.IsActive)
                    @* Hiển thị lỗi kiểm tra ngay cạnh trường dữ liệu tương ứng. *@
                    @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @* Tạo liên kết điều hướng đến action được chỉ định trong ứng dụng MVC. *@
    @Html.ActionLink("Back to List", "Index")
</div>
