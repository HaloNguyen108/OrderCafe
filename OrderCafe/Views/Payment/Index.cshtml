@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Thử thanh toán VNPay</title>
</head>
<body>
    <h2>Thử thanh toán VNPay Sandbox</h2>

    <p>Số tiền thử: 10.000đ</p>

    @* Gửi dữ liệu biểu mẫu đến action được chỉ định; action này xử lý thao tác tạo hoặc cập nhật. *@
    @using (Html.BeginForm("Create", "Payment", FormMethod.Post))
    {
        @* Sinh mã chống giả mạo yêu cầu để máy chủ xác nhận form được gửi từ website. *@
        @Html.AntiForgeryToken()

        <button type="submit">
            Thanh toán thử
        </button>
    }
</body>
</html>
