@model OrderCafe.Models.Product

<div class="col-md-4 col-sm-6">
    <div class="product-card">
        <img class="product-image"
             src="@Url.Content("~/Content/Images/" + Model.ImageUrl)"
             alt="@Model.ProductName" />

        <div class="product-info">
            <h4>@Model.ProductName</h4>

            <p>Thể loại: @Model.Category.CategoryName</p>

            <p>
                <strong>@Model.Price.ToString("#,##0") đ</strong>
            </p>

            <div class="product-actions">
                @* Gửi dữ liệu biểu mẫu đến action được chỉ định; action này xử lý thao tác tạo hoặc cập nhật. *@
                @using (Html.BeginForm("AddToCart","Cart", new { area = "" },FormMethod.Post,null))
                {
                    @* Sinh mã chống giả mạo yêu cầu để máy chủ xác nhận form được gửi từ website. *@
                    @Html.AntiForgeryToken()

                    <input type="hidden"name="id"value="@Model.ProductId" />
                          
                    <button type="submit" class="btn btn-primary">
                        Mua
                    </button>
                }

                @* Tạo liên kết đến action "Details" của controller "Product" với tham số là ID của sản phẩm. *@
                @Html.ActionLink("Chi tiết","Details","Product",new { id = Model.ProductId },new { @class = "btn product-detail-button" })                   
            </div>
        </div>
    </div>
</div>
