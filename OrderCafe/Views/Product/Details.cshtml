@model OrderCafe.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
}

<h2>Chi tiết sản phẩm</h2>
<div class="product-detail-layout">
    <!-- Ảnh sản phẩm nằm bên trái -->
    <div>
        <img class="product-detail-image"
             src="@Url.Content("~/Content/Images/" + Model.ImageUrl)"
             alt="@Model.ProductName" style="width: 200px;" />
    </div>

    <!-- Thông tin sản phẩm nằm bên phải -->
    <div class="product-detail-info">
        <h3>@Model.ProductName</h3>

        <p>
            <strong>Giá:</strong>
            <span class="product-detail-price">
                @Model.Price.ToString("#,##0") đ
            </span>
        </p>

        <p><strong>Mô tả:</strong></p>
        <p class="product-detail-description">
            @Model.Description
        </p>

        <p>
            <strong>Tình trạng:</strong>
            @(Model.IsAvailable ? "Đang phục vụ" : "Tạm hết hàng")
        </p>

        <div class="product-detail-actions">
            <!-- Chỉ hiện nút mua khi sản phẩm đang bán -->
            @if (Model.IsAvailable)
            {
                using (Html.BeginForm(
                    "AddToCart", "Cart", new { area = "" },
                    FormMethod.Post, null))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ProductId" />

                    <button type="submit" class="product-buy-button">
                        Mua ngay
                    </button>
                }
            }

            @Html.ActionLink(
                          "Quay lại Menu",
                          "Index",
                          "Product",
                          null,
                          new { @class = "product-back-button" })
        </div>
    </div>
</div>