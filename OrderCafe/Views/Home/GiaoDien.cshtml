<link rel="stylesheet" href="@Url.Content("~/Content/HomePages.css")" />
@{
    ViewBag.Title = "Trang Chu";
    Layout = "~/Views/Shared/_GiaoDien.cshtml";
}

<section class="hero" id="trangchu" aria-labelledby="hero-title">
    <img class="hero-photo" src="@Url.Content("~/Content/Images/nenCafe.jpg")" alt="Ly cà phê đặc trưng của Hạt Coffee" />
    <div class="wrap hero-content">
        <span class="eyebrow">Hạt Coffee · Rang xay mỗi ngày</span>
        <h1 id="hero-title">Một tách cà phê,<br />một khoảng thảnh thơi.</h1>
        <p class="hero-description">Ghé Hạt để thưởng thức cà phê ngon, tìm một góc dễ chịu và chậm lại giữa nhịp sống Sài Gòn.</p>
        <div class="cta">
            <a class="btn gold" href="@Url.Action("Index", "Product", new { area = "" })">Xem menu</a>
            <a class="btn line" href="@Url.Action("Index", "Product", new { area = "" })">Đặt ngay <span aria-hidden="true">&rarr;</span></a>
        </div>
    </div>
</section>
<section id="gioithieu" class="sec">
    <div class="wrap info">
        <div>
            <span class="eyebrow">Chúng tôi là</span>
            <h2>Hạt Coffee</h2>
            <p class="lead">“Chúng tôi đi khắp Tây Nguyên để tìm những hạt cà phê ngon nhất, rồi mang về rang mỗi sáng cho bạn.”</p>
            <p>Hạt Coffee là quán cà phê rang xay nằm giữa Quận 10, Sài Gòn. Ở đây bạn có thể làm việc, học bài, hẹn bạn bè hoặc chỉ ngồi yên với một tách cà phê thơm trong không gian nhiều cây xanh và nắng.</p>
        </div>
        <div class="card" id="thongtin">
            <h3>Giờ hoạt động</h3>
            <ul class="hours">
                <li><span>Thứ 2 - Thứ 6</span><b>07:00 - 22:00</b></li>
                <li><span>Thứ 7 - Chủ Nhật</span><b>07:00 - 23:00</b></li>
            </ul>
            <p class="hotline">Hotline: <a href="tel:123456789">123456789</a></p>
            <p class="addr">828 Sư Vạn Hạnh, Quận 10, TP. Hồ Chí Minh</p>
        </div>
    </div>
</section>
