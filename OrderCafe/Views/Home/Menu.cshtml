
@{
    ViewBag.Title = "Menu";
    Layout = "~/Views/Shared/GiaoDien.cshtml";
}

<h2>Menu</h2>
<link rel="stylesheet" href="~/Content/bootstrap.min.css"/>
<link rel="stylesheet" href="~/Content/GiaoDien.css"/>
<div class="row" style="margin-top: 20px;">
    <!-- CỘT BÊN TRÁI: Danh mục món (chiếm 3/12 phần) -->
    <div class="col-md-3">
        <h3>Danh mục</h3>
        <ul class="list-group">
            <li class="list-group-item">cà phê</li>
            <li class="list-group-item">trà sữa</li>
            <li class="list-group-item">bánh ngọt</li>
        </ul>
    </div>

    <!-- CỘT BÊN PHẢI: Danh sách sản phẩm (chiếm 9/12 phần) -->
    <div class="col-md-9">
        <h2>Danh sách sản phẩm</h2>

        <!-- Code danh sách sản phẩm hiển thị ở đây -->
        <div class="row">
            <div class="col-md-4">
                <div class="card p-3">
                    <h5>Cà phê sữa</h5>
                    <p>Price: 25.000 VNĐ</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3">
                    <h5>Trà sữa ô long</h5>
                    <p>Price: 30.000 VNĐ</p>
                </div>
            </div>
        </div>

    </div>
</div>
